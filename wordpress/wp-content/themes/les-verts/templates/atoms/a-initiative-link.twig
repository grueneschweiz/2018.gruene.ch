<a class="a-initiative-link" href="{{ link }}" {{ link_props(link) }}>
	<div class="a-initiative-link__image">
		{% include 'atoms/a-image.twig' with {
			'image': image,
			'size': 'medium',
			'no_caption': 1,
			'no_copy': 1
		} only %}
	</div>
	<h3 class="a-initiative-link__title">{{ title|wptexturize }}</h3>
	{% if subtitle %}
		<div class="a-initiative-link__subtitle">{{ subtitle|wptexturize }}</div>
	{% endif %}
</a>
